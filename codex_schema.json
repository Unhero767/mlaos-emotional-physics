{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex of the Wounded King - Magisterial Entry",
  "type": "object",
  "properties": {
    "artifact_id": { "type": "string" },
    "nomenclature": { "type": "string" },
    "classification_tier": { 
      "type": "string", 
      "enum": ["Archon_Protocol", "Annular_Hazard", "Deep_Sediment_Mythos", "Sovereign_Entity"] 
    },
    "ontological_weight": { "type": "number", "exclusiveMinimum": 0 },
    "epistemic_quality": { "type": "number", "minimum": 0.95, "maximum": 1.00 },
    "resonance_metrics": { 
      "type": "object", 
      "properties": { 
        "baseline_theta_E": { "type": "number" }, 
        "harmonization_constant_Hc": { "type": "number" } 
      }, 
      "required": ["baseline_theta_E", "harmonization_constant_Hc"] 
    },
    "structural_logic_A": { "type": "object" },
    "narrative_plasma_Ex": { "type": "object" },
    "kintsugi_ledger": { 
      "type": "array", 
      "items": { "type": "object" } 
    }
  },
  "required": [
    "artifact_id", "nomenclature", "classification_tier", 
    "ontological_weight", "epistemic_quality", "resonance_metrics", 
    "structural_logic_A", "narrative_plasma_Ex"
  ]
}
