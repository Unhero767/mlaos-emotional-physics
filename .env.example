# MLAOS Emotional Physics Engine - Environment Variables

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Engine Configuration
ENGINE_LOG_LEVEL=INFO
ENGINE_MODE=production

# Physics Engine Parameters
# Emotional Kinetics (Θ_E) - Primary driver of systemic momentum
EMOTIONAL_KINETICS_SCALE=1.0

# Memory Delta (Δ_M) - Rate of change in historical integrity
MEMORY_DELTA_DECAY=0.92

# Luminous Probability (L_p) - Narrative branch collapse threshold
LUMINOUS_PROBABILITY_THRESHOLD=0.5

# Testing & Validation
RUN_STRESS_TESTS=false
TEST_COVERAGE_THRESHOLD=80

# System Parameters
PARACONSISTENT_MODE=enabled
VOID_LUNG_THRESHOLD=0.4
METALOGICAL_BURN_PROTECTION=true
CONTRADICTION_TOLERANCE=0.15

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
SAVE_LOGS=true
LOG_DIR=/app/logs

# Performance
MAX_WORKERS=4
MEMORY_LIMIT=4G
COMPUTATION_TIMEOUT=3600
