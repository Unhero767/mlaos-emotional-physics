{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Magisterium_Codex_Schema",
  "description": "Ontological validation daemon for the MLAOS reality engine.",
  "type": "object",
  "properties": {
    "tier_3_sub_lexical": {
      "type": "object",
      "properties": {
        "resonance_frequency": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "thermodynamic_potential": { "type": "number" },
        "void_lung_capacity": { "type": "integer", "maximum": 100 }
      },
      "required": ["resonance_frequency", "thermodynamic_potential"]
    },
    "tier_2_syntactic": {
      "type": "object",
      "properties": {
        "chrono_anchor_id": { "type": "string", "pattern": "^ANCHOR-[A-Z0-9]{8}$" },
        "causality_vectors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "q_baseline": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "required": ["chrono_anchor_id", "q_baseline"]
    },
    "tier_1_magisterial": {
      "type": "object",
      "properties": {
        "kintsugi_scar_index": { "type": "number", "minimum": 1.0 },
        "agape_synthesis_active": { "type": "boolean" },
        "triangulated_veto_armed": { "type": "boolean" }
      },
      "required": ["kintsugi_scar_index", "agape_synthesis_active"]
    }
  },
  "required": ["tier_3_sub_lexical", "tier_2_syntactic", "tier_1_magisterial"]
}
